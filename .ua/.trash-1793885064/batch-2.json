{
  "nodes": [
    {
      "id": "file:Characters.cpp",
      "type": "file",
      "name": "Characters.cpp",
      "filePath": "Characters.cpp",
      "summary": "Implements geometry helper functions for character units — computing display scale, draw height, and half-width from a CharacterDef, with unitHalfWidth delegating to unitScale for consistent sizing.",
      "tags": ["utility", "data-model", "character-system"],
      "complexity": "simple"
    },
    {
      "id": "file:Characters.h",
      "type": "file",
      "name": "Characters.h",
      "filePath": "Characters.h",
      "summary": "Declares the CharacterDef struct and EnemyType/CharType enums that define all six unit types (three heroes and three enemies) with their cost, HP, speed, damage, and animation frame data.",
      "tags": ["data-model", "type-definition", "character-system"],
      "complexity": "simple"
    },
    {
      "id": "file:Config.h",
      "type": "file",
      "name": "Config.h",
      "filePath": "Config.h",
      "summary": "Centralizes shared game constants in the cfg namespace — lane count, board pixel dimensions, coin value, physics/timing constants — plus an inline laneBottom helper for Y-coordinate lookup.",
      "tags": ["configuration", "constants", "game-config"],
      "complexity": "simple",
      "languageNotes": "Uses a C++ namespace (cfg) to scope constants, avoiding global pollution while keeping definitions header-only."
    },
    {
      "id": "file:Game.h",
      "type": "file",
      "name": "Game.h",
      "filePath": "Game.h",
      "summary": "Central game header declaring all runtime entity structs (Unit, Projectile, Collectible, RewardPopup, Explosion) and the Game class that owns every subsystem, state machine, and per-frame update/render loop.",
      "tags": ["data-model", "game-loop", "entry-point", "service"],
      "complexity": "complex",
      "languageNotes": "Acts as the monolithic aggregation header; all subsystem headers are pulled in here, so translation units that include Game.h get the full game API."
    },
    {
      "id": "file:Renderer.cpp",
      "type": "file",
      "name": "Renderer.cpp",
      "filePath": "Renderer.cpp",
      "summary": "Implements the OpenGL 3.3 batched sprite renderer: shader compilation, single VAO/VBO sprite atlas upload, letterboxed viewport management, and all draw primitives (rect, sprite, pixel-font text with shadows/outlines).",
      "tags": ["rendering", "opengl", "service", "utility"],
      "complexity": "complex",
      "languageNotes": "Embeds a 5×7 bitmap font as a baked glyph table and uses GLM for matrix math; all draw calls go through a single VAO for minimal GL state changes."
    },
    {
      "id": "file:UI.cpp",
      "type": "file",
      "name": "UI.cpp",
      "filePath": "UI.cpp",
      "summary": "Implements all visual elements: the hero card-bar HUD, animated battlefield grid with per-background environment art (floor and edge layers), coin panel, health bars, and text helpers used by Game screens.",
      "tags": ["ui", "rendering", "battlefield", "component"],
      "complexity": "complex"
    },
    {
      "id": "file:UI.h",
      "type": "file",
      "name": "UI.h",
      "filePath": "UI.h",
      "summary": "Declares the CardBar struct and free-function prototypes for the battlefield drawing API (drawBattlefield, drawCoinPanel, drawHealthBar, drawCenteredText) used by Game::render.",
      "tags": ["ui", "type-definition", "api-handler"],
      "complexity": "simple"
    },
    {
      "id": "function:Characters.cpp:unitScale",
      "type": "function",
      "name": "unitScale",
      "filePath": "Characters.cpp",
      "lineRange": [20, 24],
      "summary": "Returns a float scale factor for a character unit based on its CharacterDef role, used to map logical grid units to pixel size.",
      "tags": ["utility", "character-system"],
      "complexity": "simple"
    },
    {
      "id": "function:Characters.cpp:unitHeight",
      "type": "function",
      "name": "unitHeight",
      "filePath": "Characters.cpp",
      "lineRange": [26, 29],
      "summary": "Returns the pixel draw height for a unit from its CharacterDef, used by the renderer to place sprites at the correct lane baseline.",
      "tags": ["utility", "character-system"],
      "complexity": "simple"
    },
    {
      "id": "function:Characters.cpp:unitHalfWidth",
      "type": "function",
      "name": "unitHalfWidth",
      "filePath": "Characters.cpp",
      "lineRange": [31, 40],
      "summary": "Returns the half-width of a unit's sprite in pixels, computed from sprite columns multiplied by unitScale, used for collision and centering.",
      "tags": ["utility", "character-system"],
      "complexity": "simple"
    },
    {
      "id": "class:Characters.h:CharacterDef",
      "type": "class",
      "name": "CharacterDef",
      "filePath": "Characters.h",
      "lineRange": [10, 22],
      "summary": "Plain data struct describing a character type's tuning values: display name, role, unlock/battle cost, max HP, movement speed, damage, attack cooldown, sprite frame offset, and draw height.",
      "tags": ["data-model", "type-definition", "character-system"],
      "complexity": "simple"
    },
